{
  "name": "@dsh-plugins/injection-guard",
  "version": "0.1.0",
  "description": "Source-aware prompt injection protection for DeepSeek Harness",
  "type": "module",
  "main": "lib/src/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:integration": "vitest run integration",
    "test:robustness": "vitest run tests/robustness.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "latest",
    "@deepseek-ai/dsh-llm": "latest",
    "@deepseek-ai/dsh-tools": "latest",
    "@deepseek-ai/schemastery": "latest",
    "fast-check": "^4.9.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
